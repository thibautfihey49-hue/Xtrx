{
  "expo": {
    "name": "Xtrx",
    "slug": "xtrx",
    "owner": "tybofihey49",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "xtrx",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.zoe.secretdiary3d"
    },
    "android": {
      "package": "com.zoe.secretdiary3d",
      "adaptiveIcon": {
        "backgroundColor": "#0a0a1a"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 34,
            "targetSdkVersion": 34,
            "buildToolsVersion": "34.0.0",
            "kotlinVersion": "1.9.24",
            "gradleVersion": "8.6"
          }
        }
      ],
      "./with-gradle-fix.js"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "fd141609-5221-4bf1-b440-94b083b7a047"
      }
    }
  }
}
